{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"customConditions": ["woldui-source"],
		"paths": {
			"@/*": ["./*"],
			"@woldui/react/components/*": ["../src/components/*"],
			"@woldui/react/lib/*": ["../src/lib/*"],
			"@woldui/react/hooks/*": ["../src/hooks/*"]
		},
		"allowJs": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.mdx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next", "out"]
}
